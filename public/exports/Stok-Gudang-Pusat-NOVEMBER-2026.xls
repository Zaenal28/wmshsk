        .bg-pesan { background-color: #FEF08A; font-weight: bold; color: #854D0E; }
        .bg-discontinue { background-color: #E2E8F0; color: #475569; }
        .text-left { text-align: left; }
        .text-right { text-align: right; }
        .font-bold { font-weight: bold; }
    </style>
